# 어떤 LLM을 쓸지: anthropic(Claude, 기본) | openai(OpenAI · Ollama · Gemini 등 OpenAI 형식)
LLM_PROVIDER=anthropic

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# claude-sonnet-5-5(기본, 더 정확) · claude-haiku-5-5(빠르고 저렴)
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI 형식 (LLM_PROVIDER=openai일 때)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# OpenAI 호환 서버(Ollama 등)를 쓸 때만. 예: http://localhost:11434/v1
OPENAI_BASE_URL=
# 추론 모델의 생각 정도: minimal / low / medium / high (비우면 모델 기본값)
OPENAI_REASONING_EFFORT=

AGENT_MAX_STEPS=6

# 프로젝트 저장 파일 (SQLite). 비워 두면 메모리에만 둔다 (서버를 다시 켜면 사라짐)
# COMPOSE_DB_PATH=data/compose.db
